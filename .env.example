# =============================================================================
# agent-manager local environment — TEMPLATE.
#
# Copy to `.env` and paste your keys. `.env` is gitignored. The FastAPI app
# and discovery scripts auto-load it via `planmyagents_api._env.load_dotenv_once()`.
#
# Run `make env-check` to see exactly which keys are configured vs. missing,
# with one-line descriptions of what each unlocks.
# =============================================================================


# -----------------------------------------------------------------------------
# Storage (required for everything)
# -----------------------------------------------------------------------------
PLANMYAGENTS_DISCOVERY_STORE_URL=postgresql://planmyagents:planmyagents@localhost:55433/planmyagents
PLANMYAGENTS_BENCHMARK_STORE_URL=postgresql://planmyagents:planmyagents@localhost:55433/planmyagents
PLANMYAGENTS_VERIFICATION_STORE_URL=postgresql://planmyagents:planmyagents@localhost:55433/planmyagents

PLANMYAGENTS_LOAD_PROMOTED_PROVIDERS_FROM_DB=true
PLANMYAGENTS_PROMOTED_PROVIDER_STORE_URL=postgresql://planmyagents:planmyagents@localhost:55433/planmyagents

# Capability demand log — every /goal refusal records one event per missing
# capability so the Open MCP Opportunities ranking has demand input. Defaults
# to data/capability_demand_events.jsonl in the repo. Set to a postgres DSN
# in production. Set PLANMYAGENTS_DEMAND_RECORDING_ENABLED=false to suppress
# (only used by deterministic tests).
PLANMYAGENTS_DEMAND_STORE_PATH=
PLANMYAGENTS_DEMAND_RECORDING_ENABLED=true

# Discovery run-event audit log. One row per source / scout invocation
# captures source_id, status, candidates_returned, elapsed_ms, query,
# and trigger ('batch' | 'scout' | 'manual'). Used by the operator
# dashboard to spot slow / broken / starved sources without trawling
# logs. Defaults to data/discovery_run_events.jsonl in the repo. Set
# to a postgres DSN in production. Set PLANMYAGENTS_RUN_LOG_ENABLED=false
# to suppress (used by deterministic tests).
PLANMYAGENTS_RUN_LOG_STORE_PATH=
PLANMYAGENTS_RUN_LOG_ENABLED=true

# Spend ledger — append-only record of every paid provider call. The
# WorkflowExecutor refuses any call that would push the per-goal or
# daily total past the configured caps. Defaults to
# data/spend_events.jsonl in the repo. Set to a postgres DSN in
# production so the daily cap survives process restarts.
PLANMYAGENTS_SPEND_LEDGER_PATH=

# Per-goal and per-day spend caps in USD. The defaults are
# deliberately conservative — these apply to the BYO-credentials
# sandbox runner (apps/api/planmyagents_api/agents/sandbox_runner.py)
# when it ships in Sprint 4 T2, and to the benchmark scheduler when
# it runs against paid baselines.
# Set PLANMYAGENTS_COST_CAP_ENABLED=false to bypass entirely (only
# used by deterministic tests / dev flows that don't have keys).
PLANMYAGENTS_COST_CAP_ENABLED=true
PLANMYAGENTS_COST_CAP_PER_GOAL_USD=0.50
PLANMYAGENTS_COST_CAP_DAILY_USD=20.00


# -----------------------------------------------------------------------------
# Embedding backend
# -----------------------------------------------------------------------------
PLANMYAGENTS_EMBEDDING_MODEL=
PLANMYAGENTS_EMBEDDING_DIM=1536


# -----------------------------------------------------------------------------
# Planner / intent mapper / coverage auditor (free, runs locally)
# -----------------------------------------------------------------------------
PLANMYAGENTS_PLANNER=local_qwen
PLANMYAGENTS_INTENT_MAPPER=local_qwen
PLANMYAGENTS_INTENT_COVERAGE_AUDIT=true
# The code default in apps/api/planmyagents_api/planner/local_qwen.py
# is `qwen3.5:35b` (~22 GB on disk / ~27 GB RAM). Override with a
# smaller tag (e.g. `qwen3:32b`) on a constrained laptop. Whatever
# model you set here MUST be `ollama pull`ed first.
PLANMYAGENTS_QWEN_MODEL=qwen3.5:35b

GROQ_API_KEY=
# Optional: comma-separated rotation of Groq models. Each model is tried
# in order before the chain falls to local Ollama Qwen — protects you
# from a single-model JSON malformation or Cloudflare 1010. Leave unset
# to use just GROQ_MODEL.
# GROQ_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,llama-3.3-70b-versatile,qwen/qwen3-32b


# =============================================================================
# DISCOVERY SOURCES — read sprint.md "Discovery source tiers" before editing.
#
# Tier 1 = first-party (we own the loop). GitHub + public catalog JSON URLs.
# Tier 2 = third-party search APIs (Tavily/Brave). Scaffolding, opt-in only.
# =============================================================================


# -----------------------------------------------------------------------------
# TIER 1 — FIRST-PARTY DISCOVERY
# -----------------------------------------------------------------------------

# https://github.com/settings/tokens (classic PAT, no scopes; 5k req/hr)
GITHUB_TOKEN=
PLANMYAGENTS_DISCOVERY_GITHUB_CODE_SEARCH=true

# Tier-1 sources, all wired in code default-ON. Toggle off for tests/offline:
# PLANMYAGENTS_DISCOVERY_OFFICIAL_MCP_REGISTRY=true   # canonical MCP registry
# PLANMYAGENTS_DISCOVERY_APIS_GURU=true               # APIs.guru OpenAPI dir
# PLANMYAGENTS_DISCOVERY_HACKER_NEWS=true             # HN top+new agent posts
# PLANMYAGENTS_DISCOVERY_VENDOR_RSS=true              # 13 curated RSS feeds
# PLANMYAGENTS_DISCOVERY_GITHUB_RECENTLY_PUSHED=true  # needs GITHUB_TOKEN

# Smithery — MCP registry scout. Falls back to silent-skip when unset,
# so leaving this blank yields "0 candidates from Smithery" with no
# error — non-obvious failure mode. https://smithery.ai → Settings → API Keys.
SMITHERY_API_KEY=

# MoltBook — A2A agent-card catalog scout. Same silent-skip semantics
# as Smithery above. https://moltbook.com (request access — invite-only beta).
MOLTBOOK_API_KEY=

# Additional public catalog JSON URLs to append.
PLANMYAGENTS_DISCOVERY_JSON_SOURCES=
PLANMYAGENTS_DISCOVERY_MCP_CATALOGS=
PLANMYAGENTS_DISCOVERY_A2A_CARDS=
PLANMYAGENTS_DISCOVERY_AI_DIRECTORIES=
PLANMYAGENTS_DISCOVERY_WEB_DOCS=

# Direct URL crawlers — point at lists of URLs we trust and crawl ourselves.
PLANMYAGENTS_DISCOVERY_LIVE_MCP_URLS=
PLANMYAGENTS_DISCOVERY_LIVE_A2A_URLS=
PLANMYAGENTS_DISCOVERY_LIVE_OPENAPI_URLS=
PLANMYAGENTS_DISCOVERY_LIVE_VENDOR_DOC_URLS=
PLANMYAGENTS_DISCOVERY_LIVE_MARKETPLACE_URLS=


# -----------------------------------------------------------------------------
# TIER 2 — THIRD-PARTY SEARCH APIS (scaffolding; OFF by default)
# WARNING: the LIVE_* toggles below are Brave/Tavily wrappers, not first-party.
# -----------------------------------------------------------------------------

# https://tavily.com (free tier 1,000 searches/month)
TAVILY_API_KEY=
# PLANMYAGENTS_DISCOVERY_TAVILY_SEARCH=true

# https://brave.com/search/api/ (free tier 2,000 queries/month)
BRAVE_SEARCH_API_KEY=
# PLANMYAGENTS_DISCOVERY_BRAVE_SEARCH=true

# PLANMYAGENTS_DISCOVERY_LIVE_SEARCH_PROVIDER=brave
# PLANMYAGENTS_DISCOVERY_LIVE_MCP_REGISTRIES=true
# PLANMYAGENTS_DISCOVERY_LIVE_A2A_CARDS=true
# PLANMYAGENTS_DISCOVERY_LIVE_OPENAPI_SPECS=true
# PLANMYAGENTS_DISCOVERY_LIVE_VENDOR_DOCS=true
# PLANMYAGENTS_DISCOVERY_LIVE_AGENT_MARKETPLACES=true


# -----------------------------------------------------------------------------
# TIER 2 — paid alternatives
# -----------------------------------------------------------------------------
EXA_API_KEY=
# PLANMYAGENTS_DISCOVERY_EXA_SEARCH=true


# =============================================================================
# Benchmark baseline credentials (OPTIONAL — leave blank in customer envs)
#
# Per the 16-May-2026 product spec, hand-written vendor wrappers in
# planmyagents_api/benchmark/baselines/ are benchmark-only — they are
# NEVER reachable from the customer /goal execution path. The keys below
# are needed ONLY when (a) running benchmark cells locally, or (b) the
# benchmark scheduler is configured to score discovered MCP / OpenAPI /
# A2A providers against a known-good baseline.
#
# Production deployments that DO NOT run the benchmark scheduler should
# leave every key in this block empty. Setting them does NOT make the
# vendor routable to user goals — that path is firewalled by
# `is_benchmark_baseline: true` in packages/registry/agents.json and
# the routing tests in tests/test_provider_router.py::BenchmarkBaselineFirewallTest.
# =============================================================================

# https://hunter.io
HUNTER_API_KEY=

# Stripe — single secret key, two consumers:
#   1. payment_authorization benchmark baseline (this section). Live-mode
#      guarded by STRIPE_ALLOW_LIVE_MODE=true.
#   2. Pro-tier billing (Pro tier section below). Live-mode guarded
#      INDEPENDENTLY by STRIPE_LIVE_MODE_OPT_IN=true; both flags must
#      flip before the same sk_live_... key is allowed to charge a card
#      AND hit the baseline.
# https://dashboard.stripe.com/apikeys (India users: invite-only; use Razorpay below).
# NOTE: declared ONCE here. A second `STRIPE_SECRET_KEY=` line under
# "Pro tier" used to live below and silently shadowed this entry when
# the file was sourced — removed 2026-05-20.
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE_MODE=true  # required to send sk_live_... keys to the BASELINE

# Razorpay — payment_authorization benchmark baseline (Indian-market path).
# https://dashboard.razorpay.com/app/keys (open signup, instant test keys, no KYC for test)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_ALLOW_LIVE_MODE=true  # required to send rzp_live_... keys to the baseline

# Resend — email_send benchmark baseline. Defaults sender to onboarding@resend.dev (Resend's
# owned shared sender) so test emails never leave Resend's sandbox. Real-domain senders
# require RESEND_ALLOW_REAL_DOMAINS=true (defense-in-depth on top of Resend's
# domain-verification step).
# https://resend.com/api-keys (free tier: 3000 emails/month, 100/day)
RESEND_API_KEY=
# RESEND_ALLOW_REAL_DOMAINS=true  # required to send from non-resend.dev addresses

# Firecrawl — web_scraping benchmark baseline. https://www.firecrawl.dev/app (free tier 500 credits/month).
# Baseline enforces http(s)-only URLs and detects RFC-2606 reserved domains as test_mode.
FIRECRAWL_API_KEY=

# Shippo — shipping_quote benchmark baseline. https://apps.goshippo.com/settings/api
# (free signup, instant test token). Baseline defaults to test mode (shippo_test_...)
# and refuses live tokens without SHIPPO_ALLOW_LIVE_MODE=true. Quote step is FREE on
# every Shippo tier.
SHIPPO_API_TOKEN=
# SHIPPO_ALLOW_LIVE_MODE=true  # required to send shippo_live_... tokens to the baseline

# eBay Browse — price_comparison benchmark baseline. https://developer.ebay.com
# (open dev signup, sandbox by default). Pass the Application Access Token
# (client_credentials grant, 2-hour TTL — refresh out-of-band). Baseline defaults
# to api.sandbox.ebay.com; production requires EBAY_ALLOW_PRODUCTION=true. Optional
# EBAY_MARKETPLACE_ID overrides the default EBAY_US.
EBAY_OAUTH_TOKEN=
# EBAY_ALLOW_PRODUCTION=true   # required to target the production Browse endpoint
# EBAY_MARKETPLACE_ID=EBAY_GB  # uppercase locale code; defaults to EBAY_US


# =============================================================================
# Pro tier (T1-B) — Clerk auth + Stripe billing + marketplace_store
#
# Required to ship saved-recipes + Pro upgrades. Leave blank in dev to keep
# the public read-only endpoints serving while you wire the rest. The verifier
# is placeholder-safe: missing config → /recipes endpoints return a clean 401.
# =============================================================================

# Clerk JWT verifier (apps/api/planmyagents_api/auth/clerk.py).
# Issuer is the per-instance Clerk URL, e.g. https://wise-koala-12.clerk.accounts.dev
# Leave PLANMYAGENTS_CLERK_ISSUER blank to disable auth (every /recipes call → 401).
PLANMYAGENTS_CLERK_ISSUER=
# Optional — derived from issuer if not set.
PLANMYAGENTS_CLERK_JWKS_URL=
# Optional CSV — restrict accepted azp (authorized party) values.
PLANMYAGENTS_CLERK_AUTHORIZED_PARTIES=

# Dev-mode bypass — accept X-Dev-Clerk-User-Id + X-Dev-Clerk-User-Email
# headers instead of a real JWT. Refused at boot when PLANMYAGENTS_ENVIRONMENT=production.
# Use ONLY for local development against an in-memory marketplace store.
# PLANMYAGENTS_AUTH_MODE=dev
# PLANMYAGENTS_ENVIRONMENT=production

# Marketplace store backend — Pro-tier users + saved_recipes tables.
# Resolution order:
#   1. PLANMYAGENTS_MARKETPLACE_STORE_URL (postgres:// → Postgres in its own schema)
#   2. PLANMYAGENTS_MARKETPLACE_STORE_PATH (SQLite file path → dev)
#   3. In-memory (test default)
# In prod, point this at the same DSN as PLANMYAGENTS_DISCOVERY_STORE_URL — the
# tables live in a SEPARATE `marketplace_store` schema for blast-radius isolation.
PLANMYAGENTS_MARKETPLACE_STORE_URL=
PLANMYAGENTS_MARKETPLACE_STORE_PATH=

# Stripe Checkout — Pro plan billing. See docs/operations.md §billing.
# STRIPE_SECRET_KEY itself is declared ONCE above (under benchmark
# adapters) — shared between the baseline and billing paths. Setting
# sk_live_... requires STRIPE_LIVE_MODE_OPT_IN=true here (defence-in-
# depth so a wrong key never charges a real card from a dev shell;
# the baseline path has its OWN opt-in flag STRIPE_ALLOW_LIVE_MODE).
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/account?upgrade=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/account?upgrade=cancelled
# STRIPE_LIVE_MODE_OPT_IN=true  # required to use sk_live_... for BILLING
