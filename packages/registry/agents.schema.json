{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanMyAgents Agent Registry",
  "description": "Schema for the v0 paid public agent registry that powers PlanMyAgents's orchestrator routing decisions.",
  "type": "object",
  "required": ["version", "updated_at", "capabilities", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "description": "SemVer of this registry document",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "description": "ISO date of last modification"
    },
    "notes": { "type": "string" },
    "capabilities": {
      "type": "array",
      "description": "Master list of capability IDs this registry covers",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/Agent" }
    },
    "discovered_agents": {
      "type": "array",
      "description": "Provider candidates discovered from unsupported user goals. These are never routable until promoted into agents.",
      "items": { "$ref": "#/definitions/DiscoveredAgent" }
    }
  },
  "definitions": {
    "Agent": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "vendor",
        "capabilities",
        "api_base_url",
        "auth",
        "is_active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable internal identifier (lowercase, hyphenated)",
          "pattern": "^[a-z0-9-]+$"
        },
        "display_name": { "type": "string" },
        "vendor": { "type": "string" },
        "vendor_url": { "type": "string", "format": "uri" },
        "provider_type": { "$ref": "#/definitions/ProviderType" },
        "runtime_mode": {
          "type": "string",
          "enum": ["production", "dev", "development", "experimental", "fixture", "local", "mock", "protocol_beta", "test"],
          "description": "Only production providers are routable by default. Dev/local/test/protocol_beta providers require PLANMYAGENTS_ALLOW_DEV_PROVIDERS=true."
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/definitions/AgentCapability" }
        },
        "api_base_url": { "type": "string", "format": "uri" },
        "auth": { "$ref": "#/definitions/Auth" },
        "rate_limit": { "$ref": "#/definitions/RateLimit" },
        "quality_notes": { "type": "string" },
        "gotchas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "whitelisted_actors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Apify-style: explicitly allowed sub-actors (vs full vendor catalog)"
        },
        "gdpr_dpa_url": { "type": "string", "format": "uri" },
        "is_active": {
          "type": "boolean",
          "description": "If false, orchestrator will not route to this agent"
        },
        "adapter_module": {
          "type": "string",
          "description": "Optional dotted path to the adapter class in module:Class form. Used by ProviderRouter to instantiate the executable adapter when ADAPTER_FACTORIES has no hardcoded entry."
        },
        "required_env_vars": {
          "type": "array",
          "items": { "type": "string" },
          "description": "All environment variables that must be set for this agent to be considered configured. Used by ProviderRouter._is_configured for multi-credential providers (Razorpay needs KEY_ID + KEY_SECRET, PayPal needs CLIENT_ID + CLIENT_SECRET, AWS-style needs ACCESS_KEY + SECRET). When set, ALL listed env vars must be present; the canonical auth.env_var is still surfaced in error messages."
        },
        "requires_benchmark_gate": {
          "type": "boolean",
          "description": "If true, ProviderRouter._passes_route_gate refuses to route until benchmark_status == 'passed'. Promoted production wrappers should set this to true so routing only opens after the bench validates the wrapper."
        },
        "benchmark_status": {
          "type": "string",
          "enum": ["not_started", "pending", "passed", "failed"],
          "description": "Tracks the wrapper's benchmark gate. Only 'passed' opens routing when requires_benchmark_gate is true."
        },
        "benchmark_status_evidence": {
          "type": "string",
          "description": "Optional human-readable provenance for the benchmark_status value. Should describe WHEN the benchmark was last run, WHICH cases were exercised, and HOW to reproduce. Set this whenever benchmark_status is flipped to 'passed' or 'failed' so an auditor can trace the claim back to a specific run instead of trusting an unattributed assertion."
        }
      }
    },
    "DiscoveredAgent": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "vendor",
        "provider_type",
        "capabilities",
        "lifecycle_status",
        "route_status",
        "will_fail",
        "will_fail_reasons",
        "required_env_vars"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "display_name": { "type": "string" },
        "vendor": { "type": "string" },
        "vendor_url": { "type": "string", "format": "uri" },
        "provider_type": { "$ref": "#/definitions/ProviderType" },
        "discovery_priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Lower number wins: MCP/A2A/AI agents before plain APIs."
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/definitions/DiscoveredCapability" }
        },
        "lifecycle_status": {
          "type": "string",
          "enum": ["discovered", "candidate", "adapter_implemented", "benchmarked", "configured", "promoted"]
        },
        "route_status": {
          "type": "string",
          "enum": ["will_fail", "not_routable", "ready_for_promotion"]
        },
        "will_fail": {
          "type": "boolean",
          "description": "True means runtime must not route to this candidate."
        },
        "will_fail_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_env_vars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "adapter_module": { "type": "string" },
        "benchmark_status": {
          "type": "string",
          "enum": ["not_started", "pending", "passed", "failed"]
        },
        "discovery": {
          "type": "object",
          "description": "Non-PII metadata about why this candidate was discovered"
        }
      }
    },
    "ProviderType": {
      "type": "string",
      "enum": ["mcp_server", "a2a_agent", "ai_agent", "api_provider", "payment_provider"]
    },
    "DiscoveredCapability": {
      "type": "object",
      "required": ["id", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": { "type": "string" }
      }
    },
    "AgentCapability": {
      "type": "object",
      "required": ["id", "tier", "endpoint", "unit_cost_usd", "pricing_model"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Capability ID (must match registry-level capabilities list)"
        },
        "tier": {
          "type": "string",
          "enum": ["primary", "secondary", "tertiary", "specialty"],
          "description": "Self-asserted tier; orchestrator uses this as a tiebreaker when benchmark scores are close"
        },
        "endpoint": {
          "type": "string",
          "description": "HTTP method + path (relative to api_base_url)"
        },
        "unit_cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Approximate cost per unit. Used for plan estimation; actual cost from invoices."
        },
        "pricing_model": {
          "type": "string",
          "enum": [
            "per_call",
            "per_credit",
            "per_request",
            "per_record",
            "per_page",
            "per_actor_run",
            "per_search",
            "per_query",
            "per_call_estimated"
          ]
        }
      }
    },
    "Auth": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "header", "query_param", "bearer", "body_field", "basic"]
        },
        "header_name": { "type": "string" },
        "param_name": { "type": "string" },
        "field_name": { "type": "string" },
        "env_var": {
          "type": "string",
          "description": "Environment variable that enables this provider in production routing"
        }
      }
    },
    "RateLimit": {
      "type": "object",
      "properties": {
        "rpm": {
          "type": "integer",
          "minimum": 1,
          "description": "Requests per minute"
        },
        "concurrent": {
          "type": "integer",
          "minimum": 1,
          "description": "Max concurrent requests"
        }
      }
    }
  }
}
