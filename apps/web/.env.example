# URL the Next.js app uses to reach the PlanMyAgents API.
# - Local dev: http://127.0.0.1:8000 (default if unset)
# - Server-rendered routes use this directly.
# - Client-side fetches (the /goal page) read NEXT_PUBLIC_PLANMYAGENTS_API_BASE_URL
#   if set; otherwise they fall back to the same default.
PLANMYAGENTS_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PLANMYAGENTS_API_BASE_URL=http://127.0.0.1:8000
