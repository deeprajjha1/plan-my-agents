  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "next": "^16.2.6",
    "react": "~19.0.3",
    "react-dom": "~19.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.12",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
